{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxlet",
  "version": "0.1.0",
  "identifier": "dev.laux.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voxlet",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#070A11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
