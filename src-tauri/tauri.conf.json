{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pumpkin Launcher",
  "mainBinaryName": "pumpkin-launcher",
  "version": "0.1.0",
  "identifier": "dev.laux.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pumpkin Launcher",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#070A11"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/instances/*/minecraft/screenshots/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "app",
      "dmg"
    ],
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMTE1MTQ4MEM3Qjk4MEEKUldRS21Ic01TRkVSdXlmbmlna2Z4alMraWhSOG9Hcm5pUWxyQk1RZW9kN0dCMXNCdGs5THJxb3oK",
      "endpoints": [
        "https://github.com/jonax1337/pumpkin-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
