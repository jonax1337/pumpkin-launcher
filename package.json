{
  "name": "pumpkin-launcher",
  "private": true,
  "version": "0.1.0",
  "description": "A Minecraft: Java Edition launcher with instances, Modrinth mods & modpacks, and presets — every world, one click.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonax1337/pumpkin-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/jonax1337/pumpkin-launcher/issues"
  },
  "author": "jonax1337",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "node scripts/sync-branding.mjs && vite",
    "build": "node scripts/sync-branding.mjs && tsc && vite build",
    "check:branding": "node src/branding/branding.check.mjs",
    "check:lib": "node src/lib/modrinth.check.mjs && node src/lib/format.check.mjs && node src/lib/routes.check.mjs",
    "preview": "vite preview",
    "dev:website": "vite --config website/vite.config.mjs",
    "build:website": "vite build --config website/vite.config.mjs",
    "preview:website": "vite preview --config website/vite.config.mjs",
    "check:website": "node website/check.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "gsap": "^3.15.0",
    "marked": "^18.0.14",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
